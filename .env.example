# Copy these into your host's environment settings (Render: Environment tab). Never commit real values.

# ---- Main AI (Gemini) ---------------------------------------------------------------------------
GEMINI_API_KEY=                      # required for Gemini. Without it Noah runs on the Qwen backup only
GEMINI_MODEL=gemini-3.5-flash-lite   # latest Flash-Lite at the time of writing
# GEMINI_MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-2.5-flash-lite
# MODEL_DISPLAY_NAME=Rexy CogniAI's Foundational Model   # the name staff see for the main model on the dashboard   # tried only if Google says 404 for the model above

# ---- Backup AI (Qwen via llama-server, started by start.sh) ---------------------------------------
# QWEN_ENABLED=1
# LLAMA_URL=http://127.0.0.1:8080/v1/chat/completions

# ---- Staff panel + sign-in tokens ----------------------------------------------------------------
STAFF_PASSWORD=                      # at least 10 characters. Opens the staff panel inside the widget
NOAH_SECRET_KEY=                     # 32+ random characters: python -c "import secrets; print(secrets.token_hex(32))"

# ---- Storage -------------------------------------------------------------------------------------
# NOAH_DB_PATH=/var/data/staff/noah.db   # RENDER: a file on your persistent disk, so nothing is lost on restart.
#                                        # Without it the app looks for a mounted disk (/var/data/staff, /var/data, /data) by itself.
# CHAT_RETENTION_DAYS=90             # chat logs older than this are deleted automatically
# REDIS_URL=                         # optional: conversation memory that survives restarts
# DATABASE_URL=                      # optional: legacy Postgres chat log (kept for /export_conversations)
# ADMIN_API_KEY=                     # legacy admin endpoints (/export_conversations, /save)

# ---- Where the widget may be embedded (the college site is already allowed) ----------------------------
# EXTRA_ALLOWED_ORIGINS=https://staging.example.com
# TRUST_PROXY_HOPS=1                 # 1 behind Render's proxy so rate limits see real visitor IPs

# ---- Notifications for callbacks / visit bookings / counselling requests (all optional) -----------------
# ADMISSIONS_EMAIL=admissions@example.edu
# COUNSELLING_EMAIL=counselling@example.edu
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noah@example.edu
# SMTP_FROM_NAME=CogniAI Studios      # sender name shown in the inbox
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER = the Gmail address, SMTP_PASSWORD = a 16-character Gmail App Password (no spaces)
# NOTIFY_WEBHOOK_URL=                # Slack incoming webhook, Zapier, Make, Google Sheets script...

# ---- WhatsApp (Meta WhatsApp Cloud API) - see README ---------------------------------------------------
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=

# ---- Switches ---------------------------------------------------------------------------------------------
# WELLNESS_ENABLED=1                 # check-in panel. The crisis safety net inside chat is always on
# STUDENT_ZONE_ENABLED=1
# WIDGET_CACHE_SECONDS=0             # 0 = browsers re-check widget.js on every page load, so updates show up at once
